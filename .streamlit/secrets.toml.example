# 8. WEBSOCKET & EVENT BROADCASTING
PUSHER_APP_ID = "1234567"
PUSHER_KEY = "your_pusher_app_key"
PUSHER_SECRET = "your_pusher_app_secret"
PUSHER_CLUSTER = "ap2"

# 9. ASSET STORAGE & CLOUD MEDIA APIS
CLOUDINARY_URL = "cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME"
AWS_REGION = "ap-south-1"
AWS_S3_BUCKET = "blinkit-product-assets-dev"
AWS_ACCESS_KEY_ID = "AKIA_YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_AWS_SECRET_ACCESS_KEY"
