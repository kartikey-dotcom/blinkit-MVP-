# ==========================================================================
# Blinkit Quick Commerce MVP - Live Environment Configuration (.env)
# ==========================================================================

# --------------------------------------------------------------------------
# 1. GOOGLE AI STUDIO / GEMINI LLM CONFIGURATION
# --------------------------------------------------------------------------
# Paste your Google AI Studio API Key below (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here

# Selected Gemini Model
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------------
# 2. SERVER & SYSTEM CONFIGURATION
# --------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_NAME=BlinkitQuickCommerceMVP
BASE_URL=http://localhost:3000

# --------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION API KEYS
# --------------------------------------------------------------------------
# Primary Platform Gateway API Key
API_KEY=blinkit_dev_api_key_8f93a102b4c5d6e7f8
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long_123456
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------------
# 4. DATABASE & CACHE CONNECTION STRINGS
# --------------------------------------------------------------------------
# PostgreSQL + PostGIS Spatial Database Connection URL
DATABASE_URL=postgresql://blinkit_user:password123@localhost:5432/blinkit_db?sslmode=disable

# Redis Connection URL (For atomic inventory locks & real-time telemetry cache)
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# 5. GEOSPATIAL & NAVIGATION MAP APIS (Rider Route Telemetry & Geofencing)
# --------------------------------------------------------------------------
# Google Maps API Key (Distance Matrix, Geocoding & Live Directions)
GOOGLE_MAPS_API_KEY=AIzaSyB_YOUR_GOOGLE_MAPS_API_KEY_HERE
MAPBOX_API_KEY=pk.eyJ1IjoiYmxpbmtpdCIsImEiOiJjbGV4YW1wbGVrZXlmdWxsMTIzNDU2Nzg5MCJ9.example

# --------------------------------------------------------------------------
# 6. PAYMENT GATEWAY APIS (Simulated / Live Checkout Processing)
# --------------------------------------------------------------------------
# Razorpay Credentials (India UPI, Cards, Netbanking & Wallets)
RAZORPAY_KEY_ID=rzp_test_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Stripe Credentials (Alternative Credit/Debit Card Gateway)
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY

# --------------------------------------------------------------------------
# 7. COMMUNICATION & SMS/OTP GATEWAY APIS (Doorstep Verification)
# --------------------------------------------------------------------------
# Twilio Credentials (SMS Delivery OTPs & IVR Automated Customer Calls)
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+18005550199

# --------------------------------------------------------------------------
# 8. WEBSOCKET & EVENT BROADCASTING (Real-time Rider GPS Telemetry)
# --------------------------------------------------------------------------
# Pusher / WebSockets API Keys (Live Order Status Stream)
PUSHER_APP_ID=1234567
PUSHER_KEY=your_pusher_app_key
PUSHER_SECRET=your_pusher_app_secret
PUSHER_CLUSTER=ap2

# --------------------------------------------------------------------------
# 9. ASSET STORAGE & CLOUD MEDIA APIS (Product Catalog Images)
# --------------------------------------------------------------------------
# Cloudinary CDN URL (Product images & Dark Store assets)
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# AWS S3 Storage Credentials
AWS_REGION=ap-south-1
AWS_S3_BUCKET=blinkit-product-assets-dev
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
